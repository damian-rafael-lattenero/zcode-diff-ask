{
  "name": "zcode-diff-ask",
  "private": true,
  "version": "0.13.0",
  "description": "Diff Ask — ZCode plugin: live workspace diff panel with per-line \"+\" to ask the agent at the exact line. Repo: plugin source + local dev marketplace + asar patch experiment.",
  "type": "module",
  "scripts": {
    "build": "node diff-ask/ui/build.mjs",
    "icons": "node scripts/gen-lang-svgs.mjs",
    "check": "node tools/check-server.mjs",
    "test": "node --test --test-concurrency=1 --test-force-exit --test-timeout=15000 tests/",
    "test:e2e": "node tests/e2e/revert.e2e.mjs"
  },
  "devDependencies": {
    "@pierre/diffs": "1.6.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "esbuild": "^0.25.0"
  }
}
